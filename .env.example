# ---- FaceClock configuration (copy to .env) ----
# Mandatory in production: a long random string shared by all workers
FACECLOCK_SECRET_KEY=change-me-to-a-long-random-string
FACECLOCK_DATABASE=/data/faceclock.db
FACECLOCK_MODELS_DIR=/app/models

# Set to false to run as a PIN-only time clock (no biometrics at all)
FACECLOCK_BIOMETRICS_ENABLED=true
FACECLOCK_LIVENESS_ENABLED=true

# Recognition tuning (cosine similarity, SFace)
FACECLOCK_MATCH_THRESHOLD=0.42
FACECLOCK_MATCH_MARGIN=0.06
FACECLOCK_MIN_FACE_SIZE=80

# Set to true behind HTTPS
FACECLOCK_SECURE_COOKIES=false
FACECLOCK_PUNCH_RETENTION_DAYS=1825
